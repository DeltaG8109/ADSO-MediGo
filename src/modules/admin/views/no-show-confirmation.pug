extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-7 text-slate-800")
    section(class="mx-auto max-w-3xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/citas") ← Volver a citas
      header(class="mt-4")
        p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
        h1(class="mt-1 text-2xl font-bold text-medigo-navy sm:text-3xl") Registrar inasistencia
        p(class="mt-1 text-sm text-slate-600") Solo puedes marcarla cuando la cita confirmada ya haya terminado.
      if message
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert")= message
      if result && result.status === "marked"
        section(class="mt-5 rounded-2xl border border-emerald-200 bg-white p-6 shadow-sm", role="status")
          p(class="text-sm font-semibold uppercase tracking-wide text-emerald-700") Inasistencia registrada
          h2(class="mt-1 text-xl font-bold text-medigo-navy") #{result.appointment.patientName} no asistió
          p(class="mt-2 text-sm text-slate-700") Cita: #{result.appointment.date} · #{result.appointment.time}
          p(class="mt-1 text-sm text-slate-700") Médico: #{result.appointment.doctorName} · #{result.appointment.specialtyName}
          p(class="mt-3 text-sm text-slate-600") Registré el cambio el #{new Intl.DateTimeFormat("es-CO", { timeZone: "America/Bogota", dateStyle: "long", timeStyle: "short" }).format(result.markedAt)}.
          a(class="mt-4 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/administrador/citas") Volver a citas
      else if preview && preview.appointment && preview.status === "ready"
        section(class="mt-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm")
          h2(class="text-lg font-bold text-medigo-navy") Confirma la inasistencia
          p(class="mt-2 text-sm text-slate-700") Paciente: #{preview.appointment.patientName}
          p(class="mt-1 text-sm text-slate-700") Médico: #{preview.appointment.doctorName} · #{preview.appointment.specialtyName}
          p(class="mt-1 text-sm text-slate-700") Cita: #{preview.appointment.date}, de #{preview.appointment.time} a #{preview.appointment.endTime}
          p(class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900") Al confirmar, el estado pasará a “No asistió”. El sistema guardará quién hizo el cambio y cuándo.
          form(action="/administrador/citas/" + preview.appointment.id + "/inasistencia", method="post", class="mt-4 flex flex-wrap gap-3")
            input(type="hidden", name="_csrf", value=csrfToken)
            input(type="hidden", name="confirmed", value="YES")
            button(class="rounded-lg bg-rose-700 px-4 py-2.5 text-sm font-semibold text-white", type="submit") Confirmar inasistencia
            a(class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold", href="/administrador/citas") Volver sin cambios
      else if !message
        p(class="mt-5 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pude cargar la cita. Inténtalo de nuevo más tarde.
