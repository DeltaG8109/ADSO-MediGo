extends ../../../views/shared/layout.pug

block content
  .min-h-screen.bg-slate-100.text-slate-800(class="lg:flex")
    aside(class="bg-medigo-navy text-white lg:flex lg:w-64 lg:flex-col lg:shrink-0")
      a(class="px-6 py-5 text-2xl font-extrabold", href="/administrador") Medi#[span(class="text-medigo-cyan") Go]
      nav(class="space-y-1 px-3 pb-4", aria-label="Navegación de administrador")
        a(class="block rounded-xl px-4 py-3 text-sm text-sky-100 hover:bg-white/10", href="/administrador") Inicio
        a(class="block rounded-xl px-4 py-3 text-sm text-sky-100 hover:bg-white/10", href="/administrador/pacientes") Pacientes
        a(class="block rounded-xl bg-medigo-cyan px-4 py-3 text-sm font-semibold", href="/administrador/citas", aria-current="page") Citas
        a(class="block rounded-xl px-4 py-3 text-sm text-sky-100 hover:bg-white/10", href="/administrador/mi-cuenta") Mi cuenta
    main(class="mx-auto w-full max-w-7xl px-4 py-7 sm:px-8")
      header(class="mb-6")
        p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
        h1(class="mt-1 text-2xl font-bold text-medigo-navy sm:text-3xl") Consultar citas
        p(class="mt-1 text-sm text-slate-600") Busca y revisa citas sin acceder a información clínica.
        a(class="mt-3 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/administrador/citas/nueva") Crear cita
      if result.status === "error" || result.status === "unavailable"
        p(role="alert", class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900") No pudimos cargar las citas. Inténtalo de nuevo más tarde.
      else if result.status === "invalid" || result.status === "invalid_date"
        p(role="alert", class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900") Revisa los filtros y vuelve a intentarlo.
      else
        form(class="mb-5 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-2 xl:grid-cols-5", action="/administrador/citas", method="get")
          label(class="sr-only", for="search") Buscar por paciente o médico
          input#search(class="rounded-lg border border-slate-300 px-3 py-2 xl:col-span-2", type="search", name="q", value=result.search, maxlength="80", placeholder="Paciente, documento o médico")
          label(class="sr-only", for="date") Filtrar por fecha
          input#date(class="rounded-lg border border-slate-300 px-3 py-2", type="date", name="fecha", value=result.selectedDate)
          label(class="sr-only", for="status") Filtrar por estado
          select#status(class="rounded-lg border border-slate-300 px-3 py-2", name="estado")
            option(value="") Todos los estados
            option(value="CONFIRMED", selected=result.selectedStatus === "CONFIRMED") Confirmada
            option(value="IN_PROGRESS", selected=result.selectedStatus === "IN_PROGRESS") En curso
            option(value="ATTENDED", selected=result.selectedStatus === "ATTENDED") Atendida
            option(value="CANCELLED", selected=result.selectedStatus === "CANCELLED") Cancelada
            option(value="NO_SHOW", selected=result.selectedStatus === "NO_SHOW") No asistió
          label(class="sr-only", for="specialty") Filtrar por especialidad
          select#specialty(class="rounded-lg border border-slate-300 px-3 py-2", name="especialidad")
            option(value="") Todas las especialidades
            each specialty in result.specialties
              option(value=specialty.id, selected=String(result.selectedSpecialty) === String(specialty.id))= specialty.name
          button(class="rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white", type="submit") Buscar
        p(class="mb-3 text-sm text-slate-600") #{result.total} cita(s) · Página #{result.page} de #{result.pageCount}
        if result.appointments.length
          .overflow-x-auto.rounded-2xl.border.border-slate-200.bg-white
            table(class="w-full min-w-[900px] text-left text-sm")
              thead(class="bg-slate-50 text-slate-600")
                tr
                  th(class="px-4 py-3") Fecha y hora
                  th(class="px-4 py-3") Paciente
                  th(class="px-4 py-3") Documento
                  th(class="px-4 py-3") Médico
                  th(class="px-4 py-3") Especialidad
                  th(class="px-4 py-3") Estado
                  th(class="px-4 py-3") Acción
              tbody
                each appointment in result.appointments
                  tr(class="border-t border-slate-100")
                    td(class="px-4 py-3 capitalize") #{appointment.date} · #{appointment.time}
                    td(class="px-4 py-3 font-semibold")= appointment.patientName
                    td(class="px-4 py-3")= appointment.patientDocument
                    td(class="px-4 py-3")= appointment.doctorName
                    td(class="px-4 py-3")= appointment.specialtyName
                    td(class="px-4 py-3")= appointment.status
                    td(class="px-4 py-3")
                      a(class="font-semibold text-medigo-blue hover:underline", href="/administrador/citas/" + appointment.id + "/gestionar") Administrar
        else
          p(role="status", class="rounded-xl bg-sky-50 p-4 text-sm text-slate-700") No encontramos citas con esos filtros.
        if result.page > 1 || result.page < result.pageCount
          nav(class="mt-5 flex items-center justify-between", aria-label="Paginación")
            if result.page > 1
              a(class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold", href="/administrador/citas?q=" + encodeURIComponent(result.search) + "&fecha=" + encodeURIComponent(result.selectedDate) + "&estado=" + encodeURIComponent(result.selectedStatus) + "&especialidad=" + encodeURIComponent(result.selectedSpecialty) + "&pagina=" + (result.page - 1)) Anterior
            else
              span
            if result.page < result.pageCount
              a(class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold", href="/administrador/citas?q=" + encodeURIComponent(result.search) + "&fecha=" + encodeURIComponent(result.selectedDate) + "&estado=" + encodeURIComponent(result.selectedStatus) + "&especialidad=" + encodeURIComponent(result.selectedSpecialty) + "&pagina=" + (result.page + 1)) Siguiente
