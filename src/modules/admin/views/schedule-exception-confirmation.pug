extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-8 text-slate-800")
    section(class="mx-auto max-w-4xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/excepciones?doctorId=" + doctor.id) ← Volver a excepciones
      header(class="mt-4")
        p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
        h1(class="mt-1 text-2xl font-bold text-medigo-navy") Confirmar bloqueo de agenda
        p(class="mt-1 text-sm text-slate-600")= doctor.name
      if previewChanged
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") Las citas afectadas cambiaron desde la revisión anterior. Revisa la lista actualizada antes de confirmar.
      section(class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
        h2(class="text-lg font-bold text-medigo-navy") Intervalo solicitado
        p(class="mt-2 text-sm") #{interval.startsLabel} – #{interval.endsLabel}
        p(class="mt-1 text-sm text-slate-600") Motivo: #{reason}
        h2(class="mt-6 text-lg font-bold text-medigo-navy") Citas futuras confirmadas afectadas
        if appointments.length
          ul(class="mt-3 divide-y divide-slate-100")
            each appointment in appointments
              li(class="py-3")
                p(class="font-semibold")= appointment.patientName
                p(class="text-sm text-slate-600") #{appointment.date} · #{appointment.time}
          p(class="mt-4 rounded-lg bg-amber-50 p-4 text-sm text-amber-900") Al confirmar, cancelaré estas citas y avisaré a los pacientes por correo.
        else
          p(class="mt-3 rounded-lg bg-emerald-50 p-4 text-sm text-emerald-900") No hay citas futuras confirmadas que se crucen con este intervalo.
        form(class="mt-6 flex flex-wrap gap-3", action="/administrador/excepciones/" + doctor.id + "/guardar", method="post")
          input(type="hidden", name="_csrf", value=csrfToken)
          input(type="hidden", name="startsAt", value=values.startsAt)
          input(type="hidden", name="endsAt", value=values.endsAt)
          input(type="hidden", name="reason", value=reason)
          input(type="hidden", name="confirmed", value="YES")
          each appointment in appointments
            input(type="hidden", name="confirmedAppointmentIds", value=appointment.id)
          button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white", type="submit") Confirmar y guardar bloqueo
          a(class="rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-700", href="/administrador/excepciones?doctorId=" + doctor.id) Cancelar
