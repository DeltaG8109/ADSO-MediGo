extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-8 text-slate-800")
    section(class="mx-auto max-w-6xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador") ← Volver al panel
      header(class="mt-4")
        p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
        h1(class="mt-1 text-2xl font-bold text-medigo-navy") Excepciones de agenda
        p(class="mt-1 text-sm text-slate-600") Bloquea un intervalo puntual en hora de Colombia. Revisaré las citas confirmadas antes de guardar.
      if message === "saved"
        p(class="mt-4 rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900", role="status") Guardé la excepción y cancelé #{cancelled || 0} cita(s) afectada(s).
      if failedNotifications
        p(class="mt-3 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No se pudieron enviar #{failedNotifications} notificación(es) por correo. El bloqueo quedó guardado.
      if page.status === "error"
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pudimos cargar las excepciones.
      else if page.status === "unavailable"
        p(class="mt-4 rounded-xl bg-sky-50 p-4 text-sm text-sky-900", role="status") La gestión de excepciones todavía no está disponible. Ejecuta las migraciones pendientes.
      form(class="mt-5 flex flex-wrap items-end gap-3 rounded-2xl border border-slate-200 bg-white p-4", action="/administrador/excepciones", method="get")
        div(class="min-w-64 flex-1")
          label(class="mb-1 block text-sm font-semibold", for="doctorId") Médico
          select#doctorId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="doctorId", required)
            option(value="") Selecciona un médico
            each doctor in page.doctors
              option(value=doctor.id, selected=page.selectedDoctor && String(page.selectedDoctor.id) === String(doctor.id))= doctor.name + " · " + doctor.specialtyName + (doctor.accountStatus === "INACTIVE" ? " · cuenta inactiva" : "")
        button(class="rounded-lg border border-medigo-blue px-4 py-2 font-semibold text-medigo-blue", type="submit") Consultar
      if page.selectedDoctor
        section(class="mt-5 grid gap-5 lg:grid-cols-2")
          article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
            h2(class="text-lg font-bold text-medigo-navy") Bloquear disponibilidad
            p(class="mt-1 text-sm text-slate-600") El intervalo puede durar unas horas o varios días.
            form(class="mt-4 space-y-4", action="/administrador/excepciones/" + page.selectedDoctor.id + "/vista-previa", method="post")
              input(type="hidden", name="_csrf", value=csrfToken)
              div
                label(class="mb-1 block text-sm font-semibold", for="startsAt") Inicio
                input#startsAt(class="w-full rounded-lg border border-slate-300 px-3 py-2", type="datetime-local", name="startsAt", value=values.startsAt || "", required)
                if errors && errors.startsAt
                  p(class="mt-1 text-sm text-rose-700", role="alert")= errors.startsAt
              div
                label(class="mb-1 block text-sm font-semibold", for="endsAt") Fin
                input#endsAt(class="w-full rounded-lg border border-slate-300 px-3 py-2", type="datetime-local", name="endsAt", value=values.endsAt || "", required)
                if errors && errors.endsAt
                  p(class="mt-1 text-sm text-rose-700", role="alert")= errors.endsAt
              div
                label(class="mb-1 block text-sm font-semibold", for="reason") Motivo
                textarea#reason(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="reason", rows="3", maxlength="255", required)= values.reason || ""
                if errors && errors.reason
                  p(class="mt-1 text-sm text-rose-700", role="alert")= errors.reason
              button(class="rounded-lg bg-medigo-blue px-5 py-3 font-semibold text-white", type="submit") Revisar citas afectadas
          article(class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
            h2(class="text-lg font-bold text-medigo-navy") Historial de excepciones
            if page.exceptions.length
              ul(class="mt-3 space-y-3")
                each exception in page.exceptions
                  li(class="rounded-xl border border-slate-200 p-4")
                    div(class="flex items-center justify-between gap-3")
                      p(class="font-semibold")= exception.reason
                      span(class=exception.status === "ACTIVE" ? "rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-800" : "rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600")= exception.status === "ACTIVE" ? "Activa" : "Inactiva"
                    p(class="mt-1 text-sm text-slate-600") #{exception.startsLabel} – #{exception.endsLabel}
            else
              p(class="mt-3 rounded-lg bg-slate-50 p-4 text-sm text-slate-600") Este médico todavía no tiene excepciones registradas.
