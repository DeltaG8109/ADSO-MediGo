extends ../../../views/shared/layout.pug

block content
  main(class="min-h-screen bg-slate-100 px-4 py-7 text-slate-800")
    section(class="mx-auto max-w-5xl")
      a(class="text-sm font-semibold text-medigo-blue hover:underline", href="/administrador/citas") ← Volver a citas
      header(class="mt-4")
        p(class="text-sm font-semibold uppercase tracking-wide text-medigo-blue") MediGo · Administración
        h1(class="mt-1 text-2xl font-bold text-medigo-navy sm:text-3xl") Crear cita para un paciente
        p(class="mt-1 text-sm text-slate-600") La cita dura 30 minutos. Solo puedes elegir horarios dentro de los próximos 30 días.
      if message
        p(class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert")= message
      if result && result.status === "booked"
        section(class="mt-5 rounded-2xl border border-emerald-200 bg-white p-6 shadow-sm", role="status")
          p(class="text-sm font-semibold uppercase tracking-wide text-emerald-700") Cita confirmada
          h2(class="mt-1 text-xl font-bold text-medigo-navy") #{result.doctor.specialtyName} · Dr(a). #{result.doctor.name}
          p(class="mt-2 text-sm text-slate-700") Paciente: #{result.patient.firstName} #{result.patient.lastName}
          p(class="mt-1 text-sm text-slate-700") #{result.appointment.date} a las #{result.appointment.time}
          if result.notificationStatus === "sent"
            p(class="mt-3 text-sm text-emerald-800") Envié la confirmación al correo del paciente.
          else if result.notificationStatus === "failed"
            p(class="mt-3 text-sm text-amber-800") La cita quedó guardada, pero no pude enviar el correo de confirmación.
          else
            p(class="mt-3 text-sm text-slate-600") La cita quedó guardada. El paciente puede verla en Mis citas.
          a(class="mt-4 inline-flex rounded-lg bg-medigo-blue px-4 py-2 text-sm font-semibold text-white", href="/administrador/citas") Volver a citas
      else if page.status === "error" || page.status === "unavailable"
        p(class="mt-5 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") No pude cargar los datos para crear la cita. Inténtalo más tarde.
      else if page.status === "invalid" || page.status === "invalid_date"
        p(class="mt-5 rounded-xl bg-amber-50 p-4 text-sm text-amber-900", role="alert") Revisa los datos seleccionados y vuelve a intentarlo.
      else
        form(action="/administrador/citas/nueva", method="get", class="mt-5 grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2")
          div
            label(class="mb-1 block text-sm font-semibold", for="patientId") Paciente
            select#patientId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="patientId", required)
              option(value="") Selecciona un paciente activo
              each patient in page.patients
                option(value=patient.id, selected=String(page.selectedPatientId) === String(patient.id)) #{patient.name} · #{patient.document}
          div
            label(class="mb-1 block text-sm font-semibold", for="specialtyId") Especialidad
            select#specialtyId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="specialtyId", required)
              option(value="") Selecciona una especialidad
              each specialty in page.specialties
                option(value=specialty.id, selected=String(page.selectedSpecialtyId) === String(specialty.id))= specialty.name
          if page.selectedSpecialty
            div
              label(class="mb-1 block text-sm font-semibold", for="doctorId") Médico
              select#doctorId(class="w-full rounded-lg border border-slate-300 px-3 py-2", name="doctorId", required)
                option(value="") Selecciona un médico
                each doctor in page.doctors
                  option(value=doctor.id, selected=String(page.selectedDoctorId) === String(doctor.id))= doctor.name
          if page.selectedDoctor
            div
              label(class="mb-1 block text-sm font-semibold", for="date") Fecha
              input#date(class="w-full rounded-lg border border-slate-300 px-3 py-2", type="date", name="date", min=page.minDate, max=page.maxDate, value=page.date, required)
          button(class="rounded-lg bg-medigo-blue px-4 py-2 font-semibold text-white sm:col-span-2", type="submit") Buscar horarios disponibles
        if page.slots.length
          section(class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
            h2(class="font-bold text-medigo-navy") Horarios disponibles · 30 minutos
            form(action="/administrador/citas/nueva/confirmar", method="post", class="mt-3")
              input(type="hidden", name="_csrf", value=csrfToken)
              input(type="hidden", name="patientId", value=page.selectedPatientId)
              input(type="hidden", name="specialtyId", value=page.selectedSpecialtyId)
              input(type="hidden", name="doctorId", value=page.selectedDoctorId)
              input(type="hidden", name="date", value=page.date)
              div(class="grid grid-cols-2 gap-2 sm:grid-cols-4")
                each slot in page.slots
                  label(class="cursor-pointer rounded-lg border border-slate-300 px-3 py-2 text-center text-sm hover:border-medigo-blue")
                    input(class="sr-only", type="radio", name="time", value=slot.time, required)
                    span= slot.label
              button(class="mt-4 rounded-lg bg-medigo-blue px-4 py-2.5 text-sm font-semibold text-white", type="submit") Confirmar cita
        else if page.selectedDoctor && page.date && page.status === "ready"
          p(class="mt-5 rounded-xl bg-sky-50 p-4 text-sm text-sky-900", role="status") No hay horarios disponibles para esa fecha.
